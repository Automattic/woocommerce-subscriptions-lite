{
    "name": "automattic/woocommerce-subscriptions-lite",
    "description": "Free subscriptions package for WooCommerce, built on the WooCommerce subscriptions engine.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "prefer-stable": true,
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "path",
            "url": "../woocommerce/packages/php/woocommerce-subscriptions-engine",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=7.4",
        "automattic/jetpack-autoloader": "^5.0",
        "automattic/woocommerce-subscriptions-engine": "0.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "woocommerce/woocommerce-sniffs": "1.0.0",
        "yoast/phpunit-polyfills": "^2.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Automattic\\WooCommerce\\SubscriptionsLite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Automattic\\WooCommerce\\SubscriptionsLite\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "autoloader-suffix": "WooSubscriptionsLite",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "automattic/jetpack-autoloader": true
        }
    },
    "scripts": {
        "lint": "phpcs -s -p",
        "lint:fix": "phpcbf -p",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit"
    }
}
